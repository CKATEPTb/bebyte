{
  "name": "bebyte",
  "version": "2.0.0",
  "description": "Fast, strict big-endian unsigned integer reader and writer for Uint8Array data.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsc -p tsconfig.json --noEmit && vitest run",
    "build": "node scripts/clean-dist.mjs && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/rewrite-dts-aliases.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CKATEPTb/bebyte.git"
  },
  "keywords": [
    "big-endian",
    "binary",
    "buffer",
    "serialization",
    "deserialization",
    "typedarray",
    "dataview",
    "uint",
    "uint8array",
    "byte",
    "bytes",
    "typescript",
    "bytewriter",
    "bytereader",
    "binary-protocol",
    "binary-parser"
  ],
  "author": "CKATEPTb, FakeIvchenko",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.11.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
